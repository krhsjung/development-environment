# MariaDB
MARIADB_VERSION=11.4.2
MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD}
MARIADB_USER=${MARIADB_USER}
MARIADB_PASSWORD=${MARIADB_PASSWORD}
MARIADB_REPLICATION_USER=${MARIADB_REPLICATION_USER:-replication}
MARIADB_REPLICATION_PASSWORD=${MARIADB_REPLICATION_PASSWORD:-b98088b290d17853eac612460239aec0}

MARIADB_DATABASE=${MARIADB_DATABASE}
MARIADB_DATABASE_DIRECTORY=/var/lib/mysql
MARIADB_WORKING_DIRECTORY=${MARIADB_DATABASE_DIRECTORY}

# MariaDB - master
MARIADB_MASTER_PORT=${MARIADB_MASTER_PORT:-3306}
MARIADB_MASTER_SERVER_ID=${MARIADB_MASTER_SERVER_ID}

# MariaDB - slave 1
MARIADB_SLAVE_1_PORT=${MARIADB_SLAVE_1_PORT:-3307}
MARIADB_SLAVE_1_SERVER_ID=${MARIADB_SLAVE_1_SERVER_ID}

# MariaDB - slave 2
MARIADB_SLAVE_2_PORT=${MARIADB_SLAVE_2_PORT:-3308}
MARIADB_SLAVE_2_SERVER_ID=${MARIADB_SLAVE_2_SERVER_ID}