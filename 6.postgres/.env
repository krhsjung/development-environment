# PostgreSQL environment variables
POSTGRES_VERSION=17.5
POSTGRES_DATABASE_DIRECTORY=/var/lib/postgresql/data

POSTGRES_REPLICATION_USER=${POSTGRES_REPLICATION_USER:-replicator}
POSTGRES_REPLICATION_PASSWORD=${POSTGRES_REPLICATION_PASSWORD:-b98088b290d17853eac612460239aec0}  # openssl rand -hex 16
POSTGRES_DB=${EXAMPLE_POSTGRES_DATABASE_NAME}

POSTGRES_LOG_LINE_PREFIX='%m [%p][db:%d][user:%u][app:%a][client:%h] '

POSTGRES_REPLICATION_SLOT=${POSTGRES_REPLICATION_SLOT:-replication_slot}
POSTGRES_REPLICATION_SLOT_TYPE=${POSTGRES_REPLICATION_SLOT_TYPE:-physical}

# PostgreSQL - master
POSTGRES_PRIMARY_PORT=${POSTGRES_PRIMARY_PORT:-5432}
POSTGRES_PRIMARY_USER=${POSTGRES_PRIMARY_USER:-postgres}
POSTGRES_PRIMARY_PASSWORD=${POSTGRES_PRIMARY_PASSWORD}  # openssl rand -hex 16

# PostgreSQL - standby
POSTGRES_STANDBY_PORT=${POSTGRES_STANDBY_PORT:-5433}
POSTGRES_STANDBY_USER=${POSTGRES_STANDBY_USER:-postgres}
POSTGRES_STANDBY_PASSWORD=${POSTGRES_STANDBY_PASSWORD}  # openssl rand -hex 16

# NestJS - PostgreSQL
EXAMPLE_NESTJS_POSTGRES_USER=${EXAMPLE_NESTJS_POSTGRES_USER}
EXAMPLE_NESTJS_POSTGRES_PASSWORD=${EXAMPLE_NESTJS_POSTGRES_PASSWORD}

# Spring Boot - PostgreSQL
EXAMPLE_SPRING_BOOT_POSTGRES_USER=${EXAMPLE_SPRING_BOOT_POSTGRES_USER}
EXAMPLE_SPRING_BOOT_POSTGRES_PASSWORD=${EXAMPLE_SPRING_BOOT_POSTGRES_PASSWORD}